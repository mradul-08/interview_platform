PORT=5001
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/codeverse
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
SESSION_SECRET=replace_with_another_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
ADMIN_EMAILS=
ADMIN_PRIVATE_KEY=

# Optional: override all language images with one custom image
# CODE_EXECUTION_IMAGE=codeverse-executor:latest
DOCKER_BIN=docker

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379
ENABLE_REDIS=false
IMPORT_CONCURRENCY=2

# OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5001/api/auth/linkedin/callback

# SMTP mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CodeVerse <no-reply@codeverse.dev>

# Local AI generator
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional third-party service keys used elsewhere in the app
STREAM_API_KEY=
STREAM_API_SECRET=

# Optional Judge0 execution fallback
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Optional LiveKit video rooms
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Optional Resend email provider
RESEND_API_KEY=
EMAIL_FROM=

# Optional Firebase integration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
